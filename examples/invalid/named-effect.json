{
  "id": "fake-oil",
  "version": "0.1.0",
  "title": "Named-effect trap",
  "taxonomyIds": ["thin-film"],
  "summary": "Negative control. Encodes a material as a boolean flag instead of composing thin-film-interference. The validator must reject this file.",
